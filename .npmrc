# Isolated linker on purpose: the Medusa admin dashboard is built against
# React 18 while the storefront runs React 19. Full hoisting would give both
# the same copy and break one of them.
strict-peer-dependencies=false
auto-install-peers=true

# `medusa build` bundles the admin with Vite, which resolves Medusa's own
# plugin entrypoints (@medusajs/dashboard, @medusajs/draft-order/admin, …)
# from the app's node_modules. Under the isolated linker those are transitive
# and therefore invisible, so hoist just that scope. React is not matched, so
# the 18/19 split above still holds.
public-hoist-pattern[]=@medusajs/*
