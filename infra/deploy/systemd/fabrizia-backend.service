# No-Docker path: the Medusa backend as a plain systemd service.
# Install: cp to /etc/systemd/system/, then systemctl enable --now fabrizia-backend
[Unit]
Description=Fabrizia commerce backend (Medusa)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=fabrizia
WorkingDirectory=/srv/fabrizia/apps/backend
EnvironmentFile=/srv/fabrizia/infra/deploy/.env.backend
ExecStart=/usr/bin/node .medusa/server/index.js
Restart=always
RestartSec=5
# Answers "who restarts a process that died at 2am" without a human.
StartLimitBurst=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fabrizia-backend

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/fabrizia/apps/backend/.medusa /srv/fabrizia/uploads

[Install]
WantedBy=multi-user.target
