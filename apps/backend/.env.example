# apps/backend/.env.example
# Copy to apps/backend/.env. Never commit the copy — .gitignore already blocks it.
# Every value here is a development placeholder. Generate real secrets per environment.

NODE_ENV=development
PORT=9000

# --- database -------------------------------------------------------------
# Commerce and CMS live in separate databases on the same instance (ADR-001 §2.1).
DATABASE_URL=postgres://fabrizia:fabrizia_dev_only@localhost:5432/fabrizia_commerce

# --- redis / valkey -------------------------------------------------------
# Required in production: without it, cache, events, workflows and locks are
# in-memory and cannot be shared between instances.
REDIS_URL=redis://localhost:6379

# --- secrets --------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_me_before_any_shared_environment
COOKIE_SECRET=replace_me_before_any_shared_environment

# --- CORS -----------------------------------------------------------------
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
MEDUSA_BACKEND_URL=http://localhost:9000

# --- object storage (MinIO locally, Cloudflare R2 in production) -----------
S3_ENDPOINT=http://localhost:9002
S3_PUBLIC_URL=http://localhost:9002/fabrizia-media
S3_BUCKET=fabrizia-media
S3_REGION=auto
S3_ACCESS_KEY_ID=fabrizia
S3_SECRET_ACCESS_KEY=fabrizia_dev_only

# --- search ---------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=fabrizia_dev_master_key_change_me

# --- store defaults -------------------------------------------------------
# EUR only — no BGN shown to customers (decision O-8).
DEFAULT_CURRENCY=eur
DEFAULT_COUNTRY=bg
DEFAULT_TAX_RATE=20

# --- Econt (decisions O-2 and O-9) ----------------------------------------
# The only courier at soft launch. Under "Онлайн продажби без касов апарат"
# Econt issues the customer's document and settles by bank transfer, so the
# integration must send order lines — product, quantity, unit price, total —
# not just the amount to collect.
ECONT_API_USERNAME=
ECONT_API_PASSWORD=
ECONT_API_BASE_URL=https://demo.econt.com/ee/services
ECONT_CUSTOMER_NUMBER=
# Cash-on-delivery without a till: set only once the contract is signed.
ECONT_ONLINE_SALES_ENABLED=false

# --- email (decision O-6) -------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Fabrizia <no-reply@fabriziafashion.bg>

# --- business rules -------------------------------------------------------
# Defaults live in packages/shared/src/commerce.ts; these override per environment.
FREE_SHIPPING_THRESHOLD_EUR=89
COD_FEE_EUR=1.50
STOCK_SAFETY_BUFFER=2

# --- card payments: phase 2 (decision O-1) --------------------------------
# Deliberately absent. Stripe / myPOS / Borica is decided after the soft launch.

# --- Speedy: phase 2 (decision O-2) ---------------------------------------
# Deliberately absent.
