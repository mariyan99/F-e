{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // @medusajs/* ship only an "exports" map, so subpath imports such as
    // @medusajs/framework/utils need Node16 resolution, not the node10 algorithm.
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "outDir": ".medusa/server",
    "types": ["node"]
  },
  "include": ["src/**/*", "medusa-config.ts"],
  "exclude": ["node_modules", ".medusa", "dist"]
}
