{
  "name": "@fabrizia/storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fabrizia storefront (Next.js 15) with Payload CMS 3 mounted at /admin",
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@fabrizia/shared": "workspace:*",
    "@medusajs/js-sdk": "2.19.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "graphql": "16.14.2",
    "next": "15.4.11",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=22.12.0 <23" }
}
