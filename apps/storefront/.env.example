# apps/storefront/.env.example
# Copy to apps/storefront/.env. Never commit the copy.

NODE_ENV=development

# --- Payload CMS ----------------------------------------------------------
# Separate database from commerce (ADR-001 §2.1).
DATABASE_URI=postgres://fabrizia:fabrizia_dev_only@localhost:5432/fabrizia_cms
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace_me_before_any_shared_environment

# --- Medusa ---------------------------------------------------------------
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Printed by `pnpm seed`. The storefront cannot read the catalogue without it.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# --- site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=bg

# Task SEO-07. Leave false until the catalogue and copy are final: turning this
# on early lets Google index test products, and that takes months to clean up.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- media (MinIO locally, Cloudflare R2 in production) -------------------
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=fabrizia-media
S3_REGION=auto
S3_ACCESS_KEY_ID=fabrizia
S3_SECRET_ACCESS_KEY=fabrizia_dev_only
NEXT_PUBLIC_MEDIA_HOSTNAME=

# --- search ---------------------------------------------------------------
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
# Search-only key, never the master key.
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=

# --- analytics (task AN-01: nothing fires before consent) -----------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
