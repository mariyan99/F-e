{
  "name": "fabrizia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:backend": "pnpm --filter @fabrizia/backend dev",
    "dev:storefront": "pnpm --filter @fabrizia/storefront dev",
    "build": "pnpm --filter @fabrizia/shared build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:migrate": "pnpm --filter @fabrizia/backend migrate && pnpm --filter @fabrizia/storefront payload:migrate",
    "seed": "pnpm --filter @fabrizia/backend seed",
    "bootstrap": "bash infra/scripts/bootstrap.sh"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@medusajs/telemetry",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "sharp"
    ],
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.4"
    }
  }
}
